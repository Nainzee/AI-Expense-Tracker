# Smart Receipt Scanner Configuration

# Application Server
PORT=7860
HOST=0.0.0.0

# Gradio Configuration
GRADIO_SHARE=0

# OCR Configuration
# Choices: "tesseract" or "trocr"
DEFAULT_OCR_ENGINE=tesseract

# Storage
RECEIPTS_DB_PATH=receipts_db/receipts.db
# v3 API (FastAPI + React)
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_SECRET_KEY=replace-with-a-long-random-string
AUTH_DISABLED=0
# Local LLM via Ollama (free, runs on your machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_VLM=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_S=120
